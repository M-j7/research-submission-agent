# Native independent noul classifier. Do not use /router/v1 for Decisions.
# Local .env is user-owned; this example is not loaded automatically.
# Generation model (OpenAI-compatible HTTPS endpoint)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_API_KEY=

# Embeddings and reranking for live knowledge retrieval
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_S=90
RERANKER_BASE_URL=https://dashscope.aliyuncs.com
RERANKER_MODEL=qwen3-rerank
RERANKER_API_KEY=

# Optional Redis cache; blank keeps the local fallback
REDIS_URL=
MEMORY_PROFILE_EVERY=10

JEV_PROVIDER=decisions
JEV_BASE_URL=https://api.perplexity.ai/v1/decisions
JEV_MODEL=pplx-decider-flash-v1.2
JEV_API_KEY=
JEV_TIMEOUT_S=30
JEV_TRUST_ENV=true

# Live context: verified qwen3.8-flash window; input cap 70%, precompression 60%.
# Public local tokenizer estimate (10% margin), never silently fall back to bytes.
# Relative paths resolve against the project root. Do not download model weights.
AGENT_CONTEXT_WINDOW_TOKENS=1000000
AGENT_TOKENIZER_PATH=.cache/tokenizers/qwen3.8-flash-next/tokenizer.json
# Optional cumulative per-role token estimate cap (separate from context window).
# AGENT_MAX_TOTAL_TOKENS=
